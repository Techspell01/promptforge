# Copy to .env.local and fill in the keys.
# All server-only: nothing here is ever sent to the browser or bundled into the APK.
# Free key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional fallback model. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Origins allowed to call the API cross-origin (the Android app is https://localhost).
CORS_ALLOWED_ORIGINS=https://localhost
# Optional limits (defaults shown). There are no accounts, so these protect the free model quota.
# DAILY_TOKEN_CAP_PER_CLIENT=60000
# MONTHLY_TOKEN_CAP_GLOBAL=5000000
# GENERATE_LIMIT_PER_MINUTE_IP=6
# LIGHT_LIMIT_PER_MINUTE_IP=120

# Android build only (public): your deployed URL. Leave empty for the web build.
NEXT_PUBLIC_API_BASE_URL=
